{
  "AppId": 3132990,
  "ExeNameHint": "b1-Win64-Shipping",
  "LaunchTimeoutSec": 180,
  "MenuTimeoutSec": 180,
  "BenchmarkTimeoutSec": 900,
  "OcrStartAfterSec": 100,
  "OcrIntervalSec": 5,
  "ResultsSettleSec": 3,
  "ExtraSearchDirs": [],

  // Главное меню: ждём его появления, кликаем первый пункт («Тест быстродействия») и принимаем диалог «Запустить тест?».
  "StartSteps": [
    { "Type": "WaitForMenu" },
    { "Type": "Click", "X": 0.115, "Y": 0.45 },
    { "Type": "ConfirmDialogs" }
  ],

  "Presets": {
    "CPU": {
      "Description": "25% render scale, GPU-heavy settings (shadows, GI, reflections, post, AA, textures, materials) at Low, frame generation off; view distance, vegetation and effects high so draw-call / simulation load stays on the CPU.",
      "Resolution": "native",
      "RenderScale": 25,
      "Quality": {
        "ViewDistance": 5, "VegetationQuality": 5, "FxQuality": 3,
        "ShadowQuality": 1, "GlobalIllumination": 1, "ReflectionQuality": 1, "PostProcessing": 1,
        "AntiAliasing": 1, "TextureQuality": 1, "MaterialQuality": 1
      },
      "Ui": { "InsertFrame": "0", "Rtx": "0" }
    },
    "GPU": {
      "Description": "100% render scale at the native display resolution, everything at the highest level, frame generation off, full ray tracing on NVIDIA RTX GPUs.",
      "Resolution": "native",
      "RenderScale": 100,
      "Quality": {
        "ViewDistance": 5, "VegetationQuality": 5, "FxQuality": 5,
        "ShadowQuality": 5, "GlobalIllumination": 5, "ReflectionQuality": 5, "PostProcessing": 5,
        "AntiAliasing": 5, "TextureQuality": 5, "MaterialQuality": 5
      },
      "Ui": { "InsertFrame": "0", "Rtx": "0" },
      "UiIfNvidiaRtx": { "Rtx": "1" }
    }
  }
}
